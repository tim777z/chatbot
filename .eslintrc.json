{
  "env": {
    "browser": true,
    "node": true,
    "es6": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "globals": {
    "$": "readonly",
    "jQuery": "readonly"
  },
  "rules": {
    "no-undef": "warn",
    "no-unused-vars": "warn",
    "no-console": "warn"
  },
  "ignorePatterns": ["node_modules/", "js/chatbot.min.js", "css/*.min.css"]
}
