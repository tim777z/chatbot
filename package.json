{
  "name": "chatbot",
  "version": "1.2.3",
  "description": "A simple chat bot in JavaScript with links to smart conversational APIs such as WebKnox (all purpose question answering), spoonacular (food related conversations), and DuckDuckGo Instant Answers (mostly entities like movies, people, and places).",
  "main": "chatbot.js",
  "scripts": {
    "test": "jest --coverage --runInBand",
    "build": "terser js/sanitize.js js/validate.js js/chatbot.js -o dist/chatbot.min.js",
    "lint": "eslint js/",
    "typecheck": "tsc --noEmit -p jsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddsky/chatbot.git"
  },
  "keywords": [
    "chatbot",
    "chat",
    "bot",
    "ai",
    "bot",
    "ecosystem:jquery",
    "jquery-plugin"
  ],
  "author": "David Urbansky",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/ddsky/chatbot/issues"
  },
  "homepage": "https://github.com/ddsky/chatbot#readme",
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "terser": "^5.51.2",
    "typescript": "5.7.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "js/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 85,
        "branches": 65
      }
    }
  }
}
